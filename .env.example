OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_DATA_DIR=.data
RAG_COLLECTION_NAME=document_rag
RAG_DEFAULT_SCOPE=default
RAG_MIN_RELEVANCE_SCORE=0.45
RAG_ENABLE_OCR=false
DOCLING_THREADS=8

# Optional local document offered by the interface. The file itself is not
# committed to the repository.
# RAG_EXAMPLE_DOCUMENT=path/to/your/document.pdf

# Optional: select OpenAI in the UI after setting these values.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Optional: expose the local base/LoRA four-way comparison in Streamlit.
# FINE_TUNE_CONFIG=fine_tuning/configs/fem_weakform_qwen3.yaml
# FINE_TUNE_ADAPTER_PATH=.data/fine_tuning/fem_weakform_qwen3/final
